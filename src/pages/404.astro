---
import Base from '../layouts/Base.astro';
import Constellation from '../components/Constellation.astro';
---

<Base titre="Page introuvable">
  <section class="perdu ciel">
    <Constellation class="perdu__constellation" />
    <div class="conteneur perdu__texte">
      <h1>Cette page n’existe pas</h1>
      <p>L’adresse a peut-être changé. Revenez à l’accueil pour retrouver votre chemin.</p>
      <a class="bouton bouton--plein" href="/">Retour à l’accueil</a>
    </div>
  </section>
</Base>

<style>
  .perdu {
    position: relative;
    overflow: hidden;
    min-height: 80vh;
    padding-block: 190px 120px;
  }

  :global(.perdu__constellation) {
    position: absolute;
    right: -6vw;
    top: 90px;
    width: min(70vw, 820px);
    color: var(--glacier);
    opacity: 0.5;
  }

  .perdu__texte {
    position: relative;
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  h1 {
    font-size: clamp(2.4rem, 5vw, 4.4rem);
    font-weight: 700;
  }
</style>
