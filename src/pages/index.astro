---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Carrousel from '../components/Carrousel.astro';
import Constellation from '../components/Constellation.astro';
import CarteBurkina from '../components/CarteBurkina.astro';
import Fin from '../components/Fin.astro';
import Photo from '../components/Photo.astro';
import { chiffres, dateLongue, histoire, missions, partenaires2025 } from '../data/site';

import herosDrone from '../assets/marque/heros-drone.png';
import intervention from '../assets/photos/intervention.jpg';
import demonstration from '../assets/photos/demonstration-drone.jpg';
import pause from '../assets/photos/pause.jpg';
import groupe from '../assets/photos/groupe-jbae-2025.jpg';
import terreNuit from '../assets/marque/terre-nuit-afrique-ouest.jpg';

const photosMissions = [
  { src: intervention, alt: 'Un intervenant présente devant le public de la JBAE 2025.' },
  { src: demonstration, alt: 'Un intervenant prépare un drone et un ordinateur devant les participants.' },
  { src: pause, alt: 'Des participants discutent à l’extérieur pendant la pause de la JBAE 2025.' },
];

const projets = (await getCollection('projets')).sort((a, b) => a.data.ordre - b.data.ordre);
const webinaires = (await getCollection('webinaires', (w) => !w.data.prive)).sort((a, b) => +b.data.date - +a.data.date);
const actualites = (await getCollection('actualites')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const mots = ['Aéronautique', 'Spatial', 'Drones', 'Satellites', 'Orientation', 'Mentorat', 'Burkina Faso'];
---

<Base>
  <section class="heros ciel">
    <div class="heros__orbite" aria-hidden="true"><i></i></div>
    <Constellation class="heros__constellation" anime />

    <div class="conteneur heros__texte">
      <h1>Donner des ailes <strong>à la jeunesse burkinabè</strong></h1>
      <p>
        Nous faisons découvrir l’aéronautique et le spatial aux jeunes du Burkina Faso, nous encourageons leur formation
        et nous les mettons en relation avec celles et ceux qui font ce secteur.
      </p>
      <div class="actions">
        <a class="bouton bouton--plein" href="/adhesion/">Adhérer à l’IBAE</a>
        <a class="bouton bouton--contour" href="/projets/">Découvrir nos projets</a>
      </div>
    </div>

    <figure class="heros__figure">
      <Image
        src={herosDrone}
        alt="Un jeune homme lève à bout de bras un drone Koukass et le regarde."
        widths={[640, 960, 1280, 1644]}
        sizes="(max-width: 860px) 112vw, 62vw"
        format="webp"
        quality={80}
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="main">Un drone Koukass à la JBAE 2025, à Ouaga 2000</figcaption>
    </figure>
  </section>

  <section class="feuille manifeste">
    <div class="conteneur manifeste__grille">
      <p class="manifeste__phrase" data-revele>
        L’aéronautique et le spatial sont en plein essor partout dans le monde. Le Burkina Faso ne doit pas rester en
        marge.
      </p>
      <div class="manifeste__suite" data-revele style="--delai:.15s">
        <p>
          L’IBAE est née de ce constat, le 1<sup>er</sup> décembre 2024, entre étudiants burkinabè en ingénierie
          aérospatiale. Nous voulons devenir la plateforme vers laquelle se tournent les Burkinabè pour toute question
          sur l’aéronautique et l’espace.
        </p>
        <a href="/a-propos/">Lire notre histoire</a>
      </div>
    </div>
  </section>

  <section class="chiffres ciel" aria-labelledby="titre-chiffres">
    <div class="conteneur">
      <h2 id="titre-chiffres">L’IBAE en quelques chiffres</h2>
      <dl class="chiffres__grille">
        {
          chiffres.map((c) => (
            <div class:list={['chiffre', { 'chiffre--accent': c.accent }]}>
              <dt>{c.libelle}</dt>
              <dd data-compte>{c.valeur}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="missions" aria-labelledby="titre-missions">
    <div class="conteneur">
      <h2 id="titre-missions">Trois missions</h2>
      <ul class="missions__liste">
        {
          missions.map((m, i) => (
            <li class="mission">
              <div data-revele="photo" style={`--delai:${i * 0.15}s`}>
                <Photo
                  class="mission__photo forme-a"
                  src={photosMissions[i].src}
                  alt={photosMissions[i].alt}
                  sizes="(max-width: 760px) 92vw, 30vw"
                  largeurs={[480, 800, 1200]}
                />
              </div>
              <h3>{m.titre}</h3>
              <p>{m.texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="projets pale" aria-labelledby="titre-projets">
    <div class="conteneur">
      <div class="projets__entete">
        <h2 id="titre-projets">Ce que nous avons fait, <strong>ce que nous préparons</strong></h2>
      </div>
      <Carrousel etiquette="Nos projets" variante="hublots" auto>
        {
          projets.map((p) => (
            <a class="escale" href={p.data.lien ?? `/projets/#${p.id}`}>
              <span class="hublot" data-revele="hublot">
                <span class="hublot__vitre">
                  <Photo src={p.data.image} alt="" sizes="(max-width: 860px) 64vw, 300px" largeurs={[320, 640]} class="hublot__photo" />
                  <span class="hublot__store" aria-hidden="true"></span>
                </span>
              </span>
              <span class="escale__statut">
                <i class="etoile"></i>
                {p.data.statut === 'realise' ? 'Réalisé' : 'En préparation'}
              </span>
              <h3>{p.data.titre}</h3>
              <p>{p.data.resume}</p>
            </a>
          ))
        }
        <a class="escale" href="/projets/">
          <span class="hublot" data-revele="hublot">
            <span class="hublot__vitre">
              <Photo src={terreNuit} alt="" sizes="(max-width: 860px) 64vw, 300px" largeurs={[320, 640]} class="hublot__photo" />
              <span class="hublot__store" aria-hidden="true"></span>
            </span>
          </span>
          <span class="escale__statut">Prochaine escale</span>
          <h3>Tous nos projets</h3>
          <p>Le détail de ce que nous avons réalisé et de ce qui arrive.</p>
        </a>
      </Carrousel>
    </div>
  </section>

  <section class="webi ciel" aria-labelledby="titre-webi">
    <div class="conteneur webi__grille">
      <div class="webi__texte" data-revele>
        <h2 id="titre-webi">Des webinaires gratuits, <strong>ouverts à tous</strong></h2>
        <p>
          Des doctorants, des ingénieurs d’Airbus, des contrôleurs aériens et des experts racontent leur parcours et
          répondent à vos questions.
        </p>
        <a class="bouton bouton--plein" href="/webinaires/">Voir tous les webinaires</a>
      </div>
      <ul class="webi__affiches">
        {
          webinaires.slice(0, 3).map((w, i) => (
            <li style={`--n:${i}`}>
              <a href={`/webinaires/${w.id}/`} aria-label={`${w.data.titre}, ${dateLongue(w.data.date)}`}>
                <Photo src={w.data.affiche} alt="" sizes="(max-width: 860px) 46vw, 300px" largeurs={[320, 640]} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="fierte" aria-labelledby="titre-fierte">
    <div class="conteneur fierte__grille">
      <div class="fierte__carte">
        <CarteBurkina />
      </div>
      <div>
        <h2 id="titre-fierte"><strong>1967</strong> n’était qu’un début</h2>
        <p class="fierte__intro">
          Le Burkina Faso, pays des hommes intègres, vole depuis longtemps. Cette histoire nous oblige, et nous voulons
          la prolonger jusqu’aux étoiles.
        </p>
        <ol class="frise">
          {
            histoire.map((h, i) => (
              <li data-revele style={`--delai:${i * 0.08}s`}>
                <span class="frise__annee">{h.annee}</span>
                <div>
                  <h3>{h.titre}</h3>
                  <p>{h.texte}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="journee" aria-labelledby="titre-journee">
    <Photo
      class="journee__photo"
      src={groupe}
      alt="Les participants de la JBAE 2025 posent devant le bâtiment avec la banderole de l’événement."
      sizes="100vw"
      largeurs={[800, 1200, 1600, 2400]}
    />
    <div class="feuille journee__feuille">
      <h2 id="titre-journee">JBAE 2025</h2>
      <p class="main">Samedi 13 septembre 2025, Ouaga 2000</p>
      <p>
        La première Journée Burkinabè de l’Aéronautique et de l’Espace a réuni plus de 50 passionnés autour de
        conférences, d’ateliers pratiques et de rencontres avec des professionnels.
      </p>
      <a href="/projets/#jbae">Découvrir la journée</a>
    </div>
    <div class="partenaires" aria-label="Nos partenaires de la JBAE 2025">
      <p>Ils étaient à nos côtés</p>
      <ul>{partenaires2025.map((p) => <li>{p}</li>)}</ul>
    </div>
  </section>

  <section class="actus section" aria-labelledby="titre-actus">
    <div class="conteneur">
      <div class="actus__entete">
        <h2 id="titre-actus">Actualités</h2>
        <a href="/actualites/">Toutes les actualités</a>
      </div>
      <ul class="actus__liste">
        {
          actualites.map((a, i) => (
            <li data-revele style={`--delai:${i * 0.1}s`}>
              <a href={`/actualites/${a.id}/`}>
                <Photo src={a.data.image} alt="" sizes="(max-width: 760px) 92vw, 30vw" largeurs={[480, 800]} class="actu__photo" />
                <time datetime={a.data.date.toISOString().slice(0, 10)}>{dateLongue(a.data.date)}</time>
                <h3>{a.data.titre}</h3>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Fin />
</Base>

<style>
  /* Héros */
  .heros {
    position: relative;
    overflow: hidden;
    min-height: clamp(640px, 100vh, 920px);
    padding-block: clamp(128px, 15vw, 190px) clamp(90px, 10vw, 140px);
  }

  .heros :global(.heros__constellation) {
    position: absolute;
    top: clamp(70px, 8vw, 110px);
    right: -3vw;
    width: min(66vw, 980px);
    color: var(--glacier);
    opacity: 0.85;
  }

  .heros__orbite {
    position: absolute;
    top: 6%;
    right: -12vw;
    width: 92vw;
    aspect-ratio: 1;
    border: 1px solid rgb(3 172 194 / 0.45);
    border-radius: 50%;
    transform: rotate(-16deg) scaleY(0.34);
    animation: tourner 26s linear infinite;
  }

  .heros__orbite i {
    position: absolute;
    top: -6px;
    left: 50%;
    width: 11px;
    height: 32px;
    background: var(--cyan);
    border-radius: 50%;
    box-shadow: 0 0 14px 4px rgb(3 172 194 / 0.7);
  }

  @keyframes tourner {
    to {
      transform: rotate(-16deg) scaleY(0.34) rotate(360deg);
    }
  }

  .heros__texte {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 24px;
  }

  h1 {
    font-size: clamp(2.7rem, 5.5vw, 5.1rem);
    max-width: 10.5em;
  }

  .heros__texte p {
    max-width: 24em;
    color: var(--glacier-pale);
  }

  .heros__figure {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: -7%;
    width: min(56vw, 1000px);
  }

  .heros__figure :global(img) {
    width: 100%;
    animation: elever 1.1s 0.15s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .heros__figure figcaption {
    position: absolute;
    right: 3%;
    top: 58%;
    width: 8.5em;
    color: var(--glacier);
    font-size: clamp(1.15rem, 1.6vw, 1.5rem);
    transform: rotate(-3deg);
  }

  @keyframes elever {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
  }

  /* Bande défilante */

  /* Manifeste */
  .manifeste__grille {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    padding-block: clamp(56px, 8vw, 104px);
  }

  .manifeste__phrase {
    font-size: clamp(1.8rem, 3.5vw, 3rem);
    font-weight: 300;
    line-height: 1.16;
    letter-spacing: -0.015em;
  }

  .manifeste__suite {
    display: grid;
    gap: 14px;
    align-content: start;
    padding-top: 0.4em;
  }

  .manifeste__suite a {
    font-weight: 700;
  }

  /* Chiffres : grille du calendrier de la JBAE */
  .chiffres {
    padding-block: var(--section);
  }

  .chiffres__grille {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: clamp(32px, 5vw, 64px);
    border-top: 1px solid rgb(193 226 247 / 0.35);
  }

  .chiffre {
    display: grid;
    grid-template-rows: auto 1fr;
    align-content: space-between;
    gap: 40px;
    padding: 18px 20px 22px;
    border-left: 1px solid rgb(193 226 247 / 0.35);
  }

  .chiffre:last-child {
    border-right: 1px solid rgb(193 226 247 / 0.35);
  }

  .chiffre dt {
    max-width: 16em;
    color: var(--glacier);
    line-height: 1.3;
  }

  .chiffre dd {
    font-size: clamp(2.8rem, 5.6vw, 5.2rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    white-space: nowrap;
    align-self: end;
  }

  .chiffre--accent dd {
    justify-self: start;
    padding: 0.06em 0.16em 0.08em;
    margin-left: -0.16em;
    font-weight: 700;
    background: var(--cyan);
    color: var(--encre);
  }

  /* Missions : photos découpées dans la silhouette du A de la JBAE */
  .missions {
    padding-block: var(--section);
    background: var(--blanc);
  }

  .missions__liste {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 44px);
    margin-top: clamp(32px, 5vw, 60px);
  }

  .mission {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .mission:nth-child(2) {
    margin-top: clamp(0px, 5vw, 72px);
  }

  .mission :global(.mission__photo) {
    width: 100%;
    aspect-ratio: 5 / 6;
    object-fit: cover;
    margin-bottom: 10px;
  }

  /* Projets */
  .projets {
    padding-block: var(--section);
  }

  .projets__entete {
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  /* Chaque projet se regarde par un hublot, le long d'un fuselage */
  .escale {
    isolation: isolate;
    display: grid;
    align-content: start;
    gap: 8px;
    color: var(--nuit);
    text-decoration: none;
  }

  .escale h3 {
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .escale:hover h3 {
    color: var(--ciel);
  }

  .escale p {
    font-size: 0.96rem;
    line-height: 1.45;
  }

  .escale__statut {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 10px;
    color: var(--ciel);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .hublot {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    padding: 11px;
    border-radius: 47% / 37%;
    background: linear-gradient(155deg, #ffffff 30%, #d7e4ee);
    box-shadow:
      0 16px 26px -14px rgb(14 40 68 / 0.5),
      inset 0 0 0 1px rgb(255 255 255 / 0.9);
  }

  /* Le liseré du fuselage passe derrière les hublots, d'une escale à l'autre */
  .hublot::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 46%;
    right: calc(var(--espace) / -2 - 1px);
    left: calc(var(--espace) / -2 - 1px);
    height: 12px;
    background: linear-gradient(180deg, var(--ciel) 0 58%, transparent 58% 72%, var(--cyan) 72%);
  }

  .hublot__vitre {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: 47% / 37%;
    background: var(--nuit);
  }

  /* Profondeur de la vitre */
  .hublot__vitre::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 5px 14px rgb(4 13 26 / 0.45);
    pointer-events: none;
  }

  .hublot :global(picture) {
    height: 100%;
  }

  .hublot :global(.hublot__photo) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .escale:hover :global(.hublot__photo) {
    transform: scale(1.05);
  }

  /* Le store remonte quand le hublot arrive à l'écran */
  .hublot__store {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, #eef3f8, #d5e1eb 92%, #b9cad8 92%);
    transform: translateY(-88%);
    transition: transform 0.9s cubic-bezier(0.65, 0, 0.2, 1);
  }

  :global(.js) .hublot:not(.vu) .hublot__store {
    transform: translateY(0);
  }

  .escale:hover .hublot__store {
    transform: translateY(-100%);
  }

  /* Webinaires */
  .webi {
    overflow: hidden;
    padding-block: var(--section);
  }

  .webi__grille {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .webi__texte {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  .webi__texte p {
    color: var(--glacier-pale);
  }

  .webi__affiches {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
  }

  .webi__affiches li {
    position: relative;
    z-index: calc(3 - var(--n));
    transform: rotate(calc((var(--n) - 1) * 4deg)) translateY(calc((var(--n) - 1) * 12px)) scale(1.18);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .webi__affiches li:hover,
  .webi__affiches li:focus-within {
    z-index: 5;
    transform: rotate(0) scale(1.3);
  }

  .webi__affiches :global(img) {
    width: 100%;
    box-shadow: 0 14px 28px rgb(4 13 26 / 0.45);
  }

  /* Fierté */
  .fierte {
    padding-block: var(--section);
    background: var(--blanc);
  }

  .fierte__grille {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }

  .fierte__carte {
    position: sticky;
    top: 110px;
  }

  .fierte h2 {
    font-size: clamp(2.2rem, 5vw, 4.4rem);
  }

  .fierte h2 strong {
    display: inline;
    color: var(--ciel);
  }

  .fierte__intro {
    margin-top: 16px;
  }

  .frise {
    display: grid;
    gap: 18px;
    margin-top: 30px;
  }

  .frise li {
    display: grid;
    grid-template-columns: 4.2em 1fr;
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid #c9dbe9;
  }

  .frise__annee {
    color: var(--ciel);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .frise h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 3px;
  }

  .frise p {
    font-size: 0.98rem;
  }

  /* JBAE 2025 */
  .journee {
    position: relative;
    background: var(--nuit);
  }

  .journee :global(.journee__photo) {
    display: block;
    width: 100%;
    height: clamp(420px, 56vw, 780px);
    object-fit: cover;
    object-position: 50% 62%;
  }

  .journee__feuille {
    display: grid;
    gap: 12px;
    justify-items: start;
    width: min(100% - 2 * var(--marge), 540px);
    margin: clamp(-150px, -10vw, -60px) 0 0 var(--marge);
    padding: 30px clamp(22px, 3vw, 40px);
  }

  .journee__feuille h2 {
    font-weight: 700;
  }

  .journee__feuille a {
    font-weight: 700;
  }

  .partenaires {
    padding: clamp(28px, 4vw, 44px) var(--marge) clamp(36px, 5vw, 56px);
    color: var(--glacier);
  }

  .partenaires p {
    max-width: none;
    margin-bottom: 10px;
    font-size: 0.98rem;
  }

  .partenaires ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px clamp(18px, 3vw, 44px);
    color: var(--blanc);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 300;
  }

  /* Actualités */
  .actus__entete {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 12px;
  }

  .actus__entete a {
    font-weight: 700;
  }

  .actus__liste {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(18px, 3vw, 36px);
    margin-top: 32px;
  }

  .actus__liste a {
    display: grid;
    gap: 8px;
    text-decoration: none;
  }

  .actus__liste a:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
  }

