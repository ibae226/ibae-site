---
// Dernier écran de chaque page : la devise, la Terre animée et les appels à l'action.
import { Image } from 'astro:assets';
import terre from '../assets/marque/terre-nuit-afrique-ouest.jpg';
import { site } from '../data/site';
---

<section class="fin">
  <div class="fin__terre" data-terre>
    <Image
      src={terre}
      alt="La Terre vue de nuit, avec l’Afrique de l’Ouest au premier plan."
      widths={[640, 1000, 1400, 1920]}
      sizes="(max-width: 700px) 820px, 94vw"
      quality={76}
      loading="lazy"
    />
    <canvas aria-hidden="true"></canvas>
    <p class="fin__repere" aria-hidden="true">
      <span class="etoile"></span>
      <span class="main">Ouagadougou</span>
    </p>
  </div>
  <div class="conteneur fin__texte">
    <h2><span lang="mos">{site.devise}</span> <strong>{site.deviseFr}</strong></h2>
    <p>
      Vous êtes étudiant, professionnel, entreprise ou institution et vous voulez avancer avec nous ? Rejoignez
      l’aventure.
    </p>
    <div class="actions">
      <a class="bouton bouton--plein" href="/adhesion/">Adhérer à l’IBAE</a>
      <a class="bouton bouton--contour" href="/partenaires/">Devenir partenaire</a>
    </div>
  </div>
</section>

<style>
  .fin {
    position: relative;
    overflow: hidden;
    padding-block: var(--section) clamp(260px, 40vw, 500px);
    background: var(--encre);
    color: var(--blanc);
    text-align: center;
  }

  .fin__terre {
    position: absolute;
    left: 50%;
    top: calc(100% - clamp(230px, 36vw, 450px));
    width: clamp(820px, 94vw, 1280px);
    aspect-ratio: 1;
    transform: translateX(-50%);
    touch-action: pan-y;
    cursor: grab;
  }

  .fin__terre :global(img),
  .fin__terre canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
  }

  .fin__terre canvas {
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .fin__terre:global(.active) canvas {
    opacity: 1;
  }

  .fin__terre:global(.active) :global(img) {
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .fin__repere {
    position: absolute;
    left: 50%;
    top: 23.5%;
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    color: var(--glacier);
    pointer-events: none;
    transform: translate(-10px, -50%);
    transition: opacity 0.3s ease;
    will-change: left, top;
  }

  .fin__repere .etoile {
    color: var(--or-bf);
    width: 20px;
    height: 20px;
  }

  .fin__repere .main {
    font-size: 1.5rem;
  }

  .fin__texte {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    gap: 22px;
  }

  h2 {
    font-size: clamp(2.5rem, 6.6vw, 5.5rem);
  }

  p {
    color: var(--glacier);
  }

  .actions {
    justify-content: center;
  }
</style>
