---
import { Image } from 'astro:assets';
import logo from '../assets/marque/logo-ibae.png';

const chemin = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

const menu = [
  { href: '/', texte: 'Accueil' },
  {
    href: '/a-propos/',
    texte: 'L’IBAE',
    sous: [
      { href: '/a-propos/', texte: 'À propos' },
      { href: '/partenaires/', texte: 'Partenaires' },
      { href: '/actualites/', texte: 'Actualités' },
    ],
  },
  {
    href: '/projets/',
    texte: 'Projets',
    sous: [
      { href: '/projets/#jbae', texte: 'JBAE' },
      { href: '/projets/#hackathon', texte: 'Hackathon' },
      { href: '/projets/#ailes-pour-elle', texte: 'Ailes pour Elle' },
      { href: '/projets/#burkina-cansat', texte: 'Burkina CanSat' },
      { href: '/projets/#mentorat', texte: 'Mentorat' },
    ],
  },
  { href: '/webinaires/', texte: 'Webinaires' },
  { href: '/orientation/', texte: 'S’orienter' },
  { href: '/contact/', texte: 'Contact' },
];

const actif = (href: string) => (href === '/' ? chemin === '/' : chemin.startsWith(href));
---

<header class="bandeau" data-entete>
  <div class="bandeau__ligne">
    <a class="bandeau__marque" href="/">
      <Image src={logo} alt="" width={64} height={64} widths={[64, 128]} sizes="64px" loading="eager" />
      <span>Initiative Burkinabè pour l’Aéronautique et l’Espace</span>
    </a>

    <nav class="nav nav--large" aria-label="Navigation principale">
      <ul>
        {
          menu.map((m) => (
            <li class:list={{ 'a-sous': m.sous }}>
              <a href={m.href} aria-current={actif(m.href) ? 'page' : undefined}>
                {m.texte}
              </a>
              {m.sous && (
                <ul class="sous">
                  {m.sous.map((s) => (
                    <li>
                      <a href={s.href}>{s.texte}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      <a class="bouton bouton--nuit nav__adherer" href="/adhesion/">Adhérer</a>
    </nav>

    <details class="nav nav--mobile">
      <summary>Menu</summary>
      <div class="nav__panneau">
        <ul>
          {
            menu.map((m) => (
              <>
                <li>
                  <a href={m.href} aria-current={actif(m.href) ? 'page' : undefined}>
                    {m.texte}
                  </a>
                </li>
                {m.sous?.filter((s) => s.href !== m.href).map((s) => (
                  <li class="retrait">
                    <a href={s.href}>{s.texte}</a>
                  </li>
                ))}
              </>
            ))
          }
          <li><a class="bouton bouton--nuit" href="/adhesion/">Adhérer</a></li>
        </ul>
      </div>
    </details>
  </div>
  <span class="fil-drapeau" aria-hidden="true"></span>
</header>

<style>
  .bandeau {
    position: fixed;
    z-index: 30;
    top: 0;
    left: clamp(8px, 4.4vw, 76px);
    right: clamp(8px, 4.4vw, 76px);
    background: var(--glacier);
    color: var(--nuit);
    box-shadow: var(--ombre-feuille);
    transition: transform 0.35s cubic-bezier(0.3, 0.7, 0.2, 1);
    view-transition-name: bandeau;
  }

  .bandeau:global(.cache) {
    transform: translateY(-112%);
  }

  .bandeau__ligne {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 9px clamp(14px, 2.4vw, 36px);
  }

  .bandeau__marque {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    text-decoration: none;
  }

  .bandeau__marque :global(img) {
    flex: none;
    width: clamp(46px, 4.4vw, 58px);
    height: auto;
  }

  .bandeau__marque span {
    max-width: 23ch;
    font-size: 0.84rem;
    line-height: 1.22;
    letter-spacing: 0.01em;
  }

  .nav a {
    text-decoration: none;
  }

  .nav--large {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 30px);
  }

  .nav--large > ul {
    display: flex;
    gap: clamp(14px, 1.8vw, 28px);
  }

  .nav--large > ul > li {
    position: relative;
  }

  .nav--large > ul > li > a {
    display: block;
    padding-block: 6px;
    border-bottom: 2px solid transparent;
    transition: border-color 0.18s ease;
  }

  .nav--large > ul > li > a:hover,
  .nav--large > ul > li > a[aria-current='page'] {
    border-bottom-color: var(--ciel);
  }

  .a-sous > a::after {
    content: '';
    display: inline-block;
    margin-left: 6px;
    border: 4px solid transparent;
    border-top-color: currentColor;
    border-bottom: 0;
    vertical-align: 2px;
  }

  .sous {
    position: absolute;
    top: 100%;
    left: -14px;
    min-width: 190px;
    padding: 8px 0;
    background: var(--blanc);
    box-shadow: var(--ombre-feuille);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
  }

  .a-sous:hover .sous,
  .a-sous:focus-within .sous {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .sous a {
    display: block;
    padding: 7px 14px;
  }

  .sous a:hover {
    background: var(--glacier-pale);
  }

  .nav__adherer {
    padding: 0.55em 1.05em;
    font-size: 0.95rem;
  }

  .nav--mobile {
    display: none;
  }

  summary {
    padding: 8px 2px;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .nav__panneau {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100vh - 76px);
    overflow-y: auto;
    padding: 12px clamp(14px, 3vw, 44px) 22px;
    background: var(--glacier);
    box-shadow: var(--ombre-feuille);
  }

  .nav__panneau a:not(.bouton) {
    display: block;
    padding: 8px 0;
    font-size: 1.12rem;
  }

  .nav__panneau a[aria-current='page'] {
    font-weight: 700;
  }

  .retrait a:not(.bouton) {
    padding: 5px 0 5px 16px;
    font-size: 1rem;
  }

  .nav__panneau .bouton {
    margin-top: 12px;
    color: var(--blanc);
  }

  @media (max-width: 1320px) {
    .bandeau__marque span {
      display: none;
    }
  }

  @media (max-width: 960px) {
    .nav--large {
      display: none;
    }

    .nav--mobile {
      display: block;
    }

    .bandeau__marque span {
      display: block;
      font-size: 0.76rem;
    }
  }
</style>
