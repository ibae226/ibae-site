---
// Drapeau du Burkina Faso, animé sur un canvas. L'image SVG sert de repli.
interface Props {
  class?: string;
}

const { class: classe = '' } = Astro.props;
---

<div class:list={['drapeau', classe]} data-drapeau role="img" aria-label="Le drapeau du Burkina Faso flotte au vent.">
  <svg viewBox="0 0 900 600" aria-hidden="true">
    <rect width="900" height="300" fill="#ef2b2d"></rect>
    <rect y="300" width="900" height="300" fill="#009e49"></rect>
    <path
      fill="#fcd116"
      d="M450 195l24.7 76 79.9 0-64.6 47 24.7 76-64.7-47-64.7 47 24.7-76-64.6-47 79.9 0z"
    ></path>
  </svg>
  <canvas aria-hidden="true"></canvas>
</div>

<style>
  .drapeau {
    position: relative;
    aspect-ratio: 3 / 2.3;
  }

  .drapeau svg {
    position: absolute;
    inset: 8% 3% 8% 3%;
    width: 94%;
    height: 84%;
  }

  .drapeau canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .drapeau:global(.active) svg {
    opacity: 0;
  }
</style>
