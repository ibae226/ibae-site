---
// Carte d'un membre de l'équipe. La photo vient de src/assets/equipe/<id>.jpg ;
// sans photo, une silhouette provisoire s'affiche.
import type { ImageMetadata } from 'astro';
import Photo from './Photo.astro';

interface Props {
  membre: { id: string; nom: string; poste: string; parcours?: string; mission?: string };
  delai?: number;
  compact?: boolean;
}

const { membre, delai = 0, compact = false } = Astro.props;
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/equipe/*.{jpg,jpeg,png,webp}');
const chargeur = Object.entries(photos).find(([chemin]) => chemin.includes(`/${membre.id}.`))?.[1];
const photo = chargeur ? (await chargeur()).default : null;
const elision = /^[AEIOUH]/i.test(membre.nom) ? 'd’' : 'de ';
---

<li class:list={['membre', { 'membre--compact': compact }]} data-revele style={`--delai:${delai}s`}>
  {
    photo ? (
      <Photo class="membre__photo forme-a" src={photo} alt={`Portrait ${elision}${membre.nom}`} sizes={compact ? '88px' : '(max-width: 620px) 130px, (max-width: 1080px) 30vw, 240px'} largeurs={compact ? [200, 320] : [320, 640]} />
    ) : (
      <svg class="membre__photo membre__provisoire forme-a" viewBox="0 0 100 120" role="img" aria-label={`Photo ${elision}${membre.nom} à venir`}>
        <circle cx="50" cy="52" r="19" />
        <path d="M14 120c0-30 15-44 36-44s36 14 36 44z" />
      </svg>
    )
  }
  <div class="membre__texte">
    <p class="membre__poste">{membre.poste}</p>
    <h4>{membre.nom}</h4>
    {membre.parcours && <p class="membre__parcours">{membre.parcours}</p>}
    {membre.mission && <p>{membre.mission}</p>}
  </div>
</li>

<style>
  .membre {
    display: grid;
    gap: 12px;
    align-content: start;
  }

  .membre :global(.membre__photo) {
    display: block;
    width: 100%;
    aspect-ratio: 5 / 6;
    object-fit: cover;
  }

  .membre__provisoire {
    background: var(--chevrons), var(--ciel);
    fill: var(--glacier);
  }

  .membre__texte {
    display: grid;
    gap: 5px;
  }

  .membre__poste {
    color: var(--ciel);
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1.25;
  }

  h4 {
    margin: 0;
    font-size: 1.28rem;
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.01em;
  }

  .membre__parcours {
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .membre__texte p:last-child {
    font-size: 0.94rem;
    line-height: 1.42;
  }

  @media (max-width: 620px) {
    .membre {
      grid-template-columns: 112px 1fr;
      gap: 16px;
      align-items: start;
    }
  }

  .membre--compact {
    grid-template-columns: 88px 1fr;
    gap: 14px;
    align-items: center;
  }

  .membre--compact h4 {
    font-size: 1.06rem;
  }

  .membre--compact .membre__texte {
    gap: 3px;
  }

  .membre--compact .membre__parcours {
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.3;
  }
</style>
