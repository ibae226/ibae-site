---
import { existsSync } from 'node:fs';
import '@fontsource/ibm-plex-sans/300.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/caveat/500.css';
import '../styles/global.css';

import Bandeau from '../components/Bandeau.astro';
import Pied from '../components/Pied.astro';
import Cookies from '../components/Cookies.astro';
import { site } from '../data/site';

interface Props {
  titre?: string;
  description?: string;
  jsonLd?: object;
}

const { titre, description = site.description, jsonLd } = Astro.props;
const titreComplet = titre ? `${titre} | IBAE` : `${site.sigle}, ${site.nom}`;
const canonique = new URL(Astro.url.pathname, Astro.site);
// Aperçu de partage : public/apercus/<adresse de la page>.jpg, sinon celui de l'accueil.
const page = Astro.url.pathname.replace(/^\/+|\/+$/g, '') || 'accueil';
const apercu = existsSync(`public/apercus/${page}.jpg`) ? page : 'accueil';
const imageOg = new URL(`/apercus/${apercu}.jpg`, Astro.site);
const altOg = `${site.sigle} : ${titre ?? 'Donner des ailes à la jeunesse burkinabè'}`;

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: site.nom,
  alternateName: site.sigle,
  url: site.url,
  logo: new URL('/icon-512.png', Astro.site),
  email: site.email,
  foundingDate: '2024-12',
  slogan: `${site.devise}, ${site.deviseFr}`,
  areaServed: 'Burkina Faso',
  sameAs: Object.values(site.reseaux).filter(Boolean),
};
---

<!doctype html>
<html lang="fr" data-audience={site.jetonAudience || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <meta name="theme-color" content="#194b84" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.sigle} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={imageOg} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={altOg} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titreComplet} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageOg} />
    <meta name="twitter:image:alt" content={altOg} />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('ibae-calme') === '1') document.documentElement.classList.add('calme');
      } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(organisation)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>
    <Bandeau />
    <main id="contenu">
      <slot />
    </main>
    <Pied />
    <Cookies />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
